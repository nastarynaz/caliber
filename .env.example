# ── Runtime ───────────────────────────────────────────────────────
# Use "demo" for isolated local training data, or "connected" after
# applying the Supabase migrations and provisioning users/access.
HUB_MODE=demo
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# true only when the site itself is served over HTTPS.
COOKIE_SECURE=false

# ── Supabase ──────────────────────────────────────────────────────
# Project Settings → API / Connect. These two values are safe for the
# browser because database and Storage access are enforced by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Project Settings → API → service_role. Server-only and required only
# for connected private uploads. Never expose or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Gemini ────────────────────────────────────────────────────────
# Explicit consent switch. When false, no source text is sent to Gemini.
GEMINI_ENABLED=false
# Create in Google AI Studio. Server-only; never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Configurable so you can use a model enabled for your account.
GEMINI_MODEL=gemini-2.5-flash
# Reserved for the semantic-index worker. Current online Q&A can use
# governed keyword retrieval without embeddings.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
# Request/evidence limits protect latency, cost, and accidental oversharing.
GEMINI_TIMEOUT_MS=20000
GEMINI_MAX_EVIDENCE_CHARS=30000
