# Runtime
# Local: development. Vercel production: production.
APP_ENV=development
# Local runs immediately with isolated fixture data. Vercel production must
# override this with HUB_MODE=connected.
HUB_MODE=demo
# Local values. Override both in Vercel production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
COOKIE_SECURE=false
# Optional. Local development defaults to .local-data; production demo mode
# defaults to the platform temporary directory.
HUB_DEMO_DATA_DIR=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional judge access. These are real Supabase Auth accounts; credentials stay
# server-side and are exchanged for normal authenticated sessions with RLS.
JUDGE_DEMO_ENABLED=true
JUDGE_ENGINEER_EMAIL=
JUDGE_ENGINEER_PASSWORD=
JUDGE_READER_EMAIL=
JUDGE_READER_PASSWORD=
JUDGE_CONTROLLER_EMAIL=
JUDGE_CONTROLLER_PASSWORD=
JUDGE_REVIEWER_EMAIL=
JUDGE_REVIEWER_PASSWORD=

# Gemini
# When false, no source text is sent to Gemini.
GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_TIMEOUT_MS=20000
GEMINI_MAX_EVIDENCE_CHARS=30000
# Ephemeral provider copies are deleted immediately after persisted extraction.
GEMINI_DELETE_PROCESSING_FILE=true
# Private source links should be short-lived when signed URLs are used.
SOURCE_SIGNED_URL_TTL_SECONDS=600
